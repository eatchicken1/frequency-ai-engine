{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "timeseries",
      "title": "Workflow QPS by Result",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(frequency_runtime_workflow_runs_total[5m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workflow P95 Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(frequency_runtime_workflow_duration_seconds_bucket[5m])) by (le, workflow))",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Auth Reject by Reason",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(frequency_runtime_auth_attempts_total{result=\"rejected\"}[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Nonce Store Failures",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(frequency_runtime_nonce_store_total{result=\"error\"}[5m])) by (store_type)",
          "legendFormat": "{{store_type}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["frequency", "ai-runtime"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Frequency AI Runtime Overview",
  "version": 1
}
